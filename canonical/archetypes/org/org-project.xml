         Decision de Alberto: UPeU no tiene contratistas, visitantes ni personal
         de instituciones asociadas modelados como identidades propias, ni
         proyectos como OrgType. Se archiva en vez de borrar: si el dia de manana
         aparece la necesidad, se reactiva sin rehacer el modelo. -->
    <lifecycleState>archived</lifecycleState>
    <assignment>
        <assignmentRelation>
            <holderType>OrgType</holderType>
        </assignmentRelation>
    </assignment>
    <archetypePolicy>
        <display>
            <label>Proyecto</label>
            <pluralLabel>Proyectos</pluralLabel>
            <icon>
                <cssClass>fa fa-project-diagram</cssClass>
                <color>#e67e22</color>
            </icon>
        </display>
    </archetypePolicy>
</archetype>