<?xml version="1.0" encoding="UTF-8"?>
<!-- ADR-065 · NO DESPLEGADO — requiere aprobacion de Alberto.
     Un Application Role por equipo. Unico efecto: la pertenencia al grupo
     groupOfUniqueNames cn=dti-dev-*,ou=groups,dc=upeu,dc=edu,dc=pe, que el overlay
     memberof publica como memberOf en la persona — que es lo que leen las apps.
     NO se autoasignan desde un atributo: los induce su OrgType (02-orgs-dti-dev.xml),
     para que la unica autoridad sea el arbol y no haya un segundo atributo que mantener.
     El prefijo dti-dev- cae DENTRO de la delineacion ya existente del objectType
     entitlement/group (id 497: baseContext ou=groups, scope one, filtro cn empieza por
     "dti-"), por eso este diseno NO exige ningun cambio en el resource 7b4e1c2d.
     createOnDemand=false: los 9 grupos deben existir antes (04-grupos-ldap.ldif). -->
<objects xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3" xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3" xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3" xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3">
    <role oid="d71ade01-0000-4000-a000-d71ade010001">
        <name>AR-DTI-Dev-academico</name>
        <description>Application Role que otorga la pertenencia al grupo LDAP cn=dti-dev-academico,ou=groups,dc=upeu,dc=edu,dc=pe, correspondiente al equipo de desarrollo "Lamb Academico" de la DTI. Lo induce el OrgType DTI-DEV-ACADEMICO; no se asigna a mano ni se autoasigna desde ningun atributo.</description>
        <subtype>dti-dev-team</subtype>
        <displayName>DTI Dev · Lamb Academico</displayName>
        <identifier>DTI-DEV-ACADEMICO</identifier>
        <lifecycleState>active</lifecycleState>
        <inducement>
            <construction>
                <resourceRef oid="7b4e1c2d-3f8a-4d6b-9e5c-0a1b2c3d4e5f" type="c:ResourceType"/>
                <kind>account</kind>
                <intent>default</intent>
                <association>
                    <ref>ri:group</ref>
                    <outbound>
                        <strength>strong</strength>
                        <expression>
                            <associationTargetSearch>
                                <filter>
                                    <q:equal>
                                        <q:path>attributes/ri:dn</q:path>
                                        <q:value>cn=dti-dev-academico,ou=groups,dc=upeu,dc=edu,dc=pe</q:value>
                                    </q:equal>
                                </filter>
                                <createOnDemand>false</createOnDemand>
                            </associationTargetSearch>
                        </expression>
                    </outbound>
                </association>
            </construction>
        </inducement>
    </role>
