            <c:name>ACT-limpiar-disabled-automatico-si-vinculo-vivo</c:name>
            <c:lifecycleState>proposed</c:lifecycleState>
            <c:strength>strong</c:strength>
            <c:source>
                <c:name>adminStatus</c:name>
                <c:path>activation/administrativeStatus</c:path>
            </c:source>
            <c:source>
                <c:name>worker</c:name>
