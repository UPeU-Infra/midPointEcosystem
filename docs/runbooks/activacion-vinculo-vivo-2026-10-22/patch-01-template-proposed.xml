            <c:lifecycleState>proposed</c:lifecycleState>
            <c:strength>strong</c:strength>
            <c:source>
                <c:name>student</c:name>
                <c:path>extension/sciback:liveAffiliationStudent</c:path>
            </c:source>
            <c:expression>
                <c:script>
                    <c:code>null</c:code>
                </c:script>
            </c:expression>
            <c:target>
                <c:path>extension/sciback:liveAffiliationStudent</c:path>
            </c:target>
            <c:condition>
                <c:script>
                    <c:code>
