            <c:target>
                <c:path>activation/administrativeStatus</c:path>
            </c:target>
            <c:condition>
                <c:script>
                    <c:code>
def liveOf = { it != null &amp;&amp; basic.stringify(it).trim() != '' }
def anyLive = liveOf(worker) || liveOf(student) || liveOf(alum)
return anyLive &amp;&amp; adminStatus != null &amp;&amp; adminStatus.toString().equalsIgnoreCase('disabled')
                    </c:code>
                </c:script>
            </c:condition>
        </t:value>
