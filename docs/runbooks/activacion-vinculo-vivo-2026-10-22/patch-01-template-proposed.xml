try { return !midpoint.hasLinkedAccount('6a91f7e1-1b50-4dcf-9c4b-7c0c0e0e0e22') } catch (Exception e) { log.warn('R1: hasLinkedAccount fallo en {}: {} -> no se retira', focus?.name, e.message); return false }
