                <ref>ri:group</ref>
                <outbound>
                    <strength>strong</strength>
                    <expression>
                        <associationTargetSearch>
                            <filter>
                                <q:equal>
                                    <q:path>attributes/ri:dn</q:path>
                                    <q:value>cn=dti-conservatory,ou=groups,dc=upeu,dc=edu,dc=pe</q:value>
                                </q:equal>
                            </filter>
                            <createOnDemand>false</createOnDemand>
