    <name>AR-DTI-Team-conservatory</name>
    <description>Application Role que otorga la pertenencia al grupo LDAP cn=dti-conservatory,ou=groups,dc=upeu,dc=edu,dc=pe, correspondiente al equipo de desarrollo Conservatory (2 personas) del modelo de organizacion validado por el director de la DTI. Se autoasigna desde el template global por extension/upeu:serviceDeskTeam; la clave de union es identifier. Creado 2026-09-15 (ADR-066). Desde 2026-10-02 induce AR-Zammad-Cola-Desarrollo-LAMB-Conservatory (cola Zammad 27, creada el 29-sep).</description>
    <subtype>dti-service-desk-team</subtype>
    <lifecycleState>active</lifecycleState>
    <assignment>
        <targetRef oid="279ad5be-a892-4add-946f-8cb3740bfc31" relation="org:default" type="c:ArchetypeType"/>
    </assignment>
    <displayName>DTI - Conservatory</displayName>
    <identifier>Conservatory</identifier>
