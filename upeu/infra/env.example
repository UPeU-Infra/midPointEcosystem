# Plantilla de /opt/midpoint/.env de MidPoint PROD (copiar como .env) — SIN VALORES.
# El .env real vive solo en el host (permisos 600) y en el backup diario del home.
# Nunca commitear valores reales: este repositorio es PUBLICO.
POSTGRES_USER=midpoint
MP_DB_PASSWORD=
MP_ADMIN_PASSWORD=
# Version de la imagen evolveum/midpoint (sufijos -ubuntu en el servidor y -alpine en data_init).
# 4.10.2 hoy; 4.10.5 tras la ventana F2; 4.11.0 tras la ventana F3.
MP_VER=4.10.2
# Contrasena del truststore /opt/midpoint/certs/truststore.jceks.
# OJO: en el host la contrasena esta hoy escrita en el compose, no en el .env.
# Al pasar al compose del repo hay que anadir esta linea al .env del host.
MP_TRUSTSTORE_PASSWORD=
