<?xml version="1.0" encoding="UTF-8"?>
<!--
  Oracle LAMB Sedes — catálogo autoritativo de sedes (dimensión geográfica).
  DR: docs/DECISION-arbol-sedes-organization-tree.md (Fase 1).

  POR QUÉ UN RESOURCE PROPIO Y NO UN objectType EN "Oracle LAMB Org":
  el resource Org declara UNA sola objectClass (ObjectClass.ACCOUNT_NAME) en su schemaScript
  y su <schema> está cacheado. Añadir una segunda objectClass obliga a tocar schemaScript +
  refrescar schema sobre un resource ya validado (área↔Oracle 2.322/2.322 el 4-ago). El patrón
  establecido en este despliegue es un resource por dominio LAMB (Trabajadores, Estudiantes,
  Egresados, Org, Posiciones, Grados, RENIEC) — este lo sigue. Aislado y reversible.

  FUENTE: ELISEO.ORG_SEDE. ALCANCE: ID_SEDE IN (1,2,3) — sedes UPeU directas.
  Fuera de alcance por decisión: 4=Sede ISTAT, 5=Clínica Good Hope, 6=American Global Tech
  University (entidades jurídicas distintas; Ley 29733 art. 7 proporcionalidad).

  CLAVE: identifier = 'SEDE-' + ID_SEDE.  El prefijo NO es cosmético: el identifier desnudo
  (1/2/3) colisiona con ID_AREA 1/2/3 (Asamblea Universitaria / Consejo Universitario /
  Rectorado) y el mapping id-parent-to-parentOrg del resource Org busca 'identifier = ID_PARENT'
  numérico. Verificado en PROD 2026-08-05.

  FASE 1 — ALCANCE DELIBERADAMENTE LIMITADO:
  este objectType NO mapea parentOrg. Los 3 campus siguen colgando de UPeU (árbol funcional)
  porque los colegios (Colegio Unión, CAT, CU-Tarapoto, ISTAT) y sus ~91 personas cuelgan de
  ellos. El reparenting a SEDES-UPEU se hace en Fase 3, después de mover esos hijos a
  "Unidades Adscritas". Añadir aquí el parent movería toda la rama sin simulación previa.
-->
<resource xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
    xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
    xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3"
    xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
    xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3"
    xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
    xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3"
    xmlns:upeu="urn:upeu:midpoint:local"
    oid="f21edcac-d151-4d48-a357-e6b3cfdcf736">

    <name>Oracle LAMB Sedes</name>
    <description>Inbound ScriptedSQL desde ELISEO.ORG_SEDE. Catálogo de sedes UPeU (ID_SEDE 1,2,3) como OrgType. Dimensión conformada con dw-olap dim_sede. IIA Patrón B: focus=OrgType, NO toca UserType. DR arbol-sedes Fase 1 (2026-08-05).</description>
    <lifecycleState>active</lifecycleState>

    <!-- Mismo connector ScriptedSQL Tirasa y misma instancia Oracle que los otros LAMB resources -->
    <connectorRef oid="e4cd8ed3-2e91-48d9-abb7-32090a5e8849" relation="org:default" type="c:ConnectorType"/>

    <connectorConfiguration xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3">
        <icfc:resultsHandlerConfiguration>
            <icfc:enableNormalizingResultsHandler>false</icfc:enableNormalizingResultsHandler>
            <icfc:enableFilteredResultsHandler>false</icfc:enableFilteredResultsHandler>
            <icfc:filteredResultsHandlerInValidationMode>true</icfc:filteredResultsHandlerInValidationMode>
            <icfc:enableAttributesToGetSearchResultsHandler>false</icfc:enableAttributesToGetSearchResultsHandler>
        </icfc:resultsHandlerConfiguration>

        <icfc:configurationProperties xmlns:cfg="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/net.tirasa.connid.bundles.db.scriptedsql/net.tirasa.connid.bundles.db.scriptedsql.ScriptedSQLConnector">
            <cfg:host>192.168.13.9</cfg:host>
            <cfg:port>1521</cfg:port>
            <cfg:user>JUANSANCHEZ</cfg:user>
            <!-- Password cifrado idéntico al de los otros LAMB resources (misma instancia Oracle) -->
            <cfg:password>
                <t:encryptedData>
                    <t:encryptionMethod>
                        <t:algorithm>http://www.w3.org/2001/04/xmlenc#aes256-cbc</t:algorithm>
                    </t:encryptionMethod>
                    <t:keyInfo>
                        <t:keyName>nkZ4VieDLlRmwD8hdryrmjz8IxQ=</t:keyName>
                    </t:keyInfo>
                    <t:cipherData>
                        <t:cipherValue>5PiBLf405M3U4ulm9p6WfqMMVVwtOcVl5PuL6/CqPRMTmbA5Aoa/axj4ks8onfI2</t:cipherValue>
                    </t:cipherData>
                </t:encryptedData>
            </cfg:password>
            <cfg:database>UPEU</cfg:database>
            <cfg:jdbcDriver>oracle.jdbc.OracleDriver</cfg:jdbcDriver>
            <cfg:jdbcUrlTemplate>jdbc:oracle:thin:@%h:%p/%d</cfg:jdbcUrlTemplate>
            <cfg:rethrowAllSQLExceptions>true</cfg:rethrowAllSQLExceptions>
            <cfg:nativeTimestamps>true</cfg:nativeTimestamps>
            <cfg:allNative>false</cfg:allNative>
            <cfg:scriptingLanguage>GROOVY</cfg:scriptingLanguage>
            <cfg:reloadScriptOnExecution>false</cfg:reloadScriptOnExecution>

            <!-- searchScript — catálogo ELISEO.ORG_SEDE acotado a las sedes UPeU directas.
                 UID = ID_SEDE (inmutable). NAME = 'SEDE-' || ID_SEDE.
                 Columnas verificadas en vivo 2026-08-05: ID_SEDE, NOMBRE, CODIGO, ID_DEPTO,
                 SCHOOLID, SIGLA, CODIGO_XPRESS_EDUCA, CODSUNEDU.
                 Script en una sola línea lógica (sin saltos reales). -->
            <cfg:searchScript>import groovy.sql.Sql; def sql = new Sql(connection); def result = []; def baseQuery = 'SELECT s.ID_SEDE, s.NOMBRE, s.SIGLA, s.CODIGO, s.CODSUNEDU FROM ELISEO.ORG_SEDE s WHERE s.ID_SEDE IN (1,2,3)'; def whereClause = ''; def params = []; if (query != null) { if (query.operation == 'EQUALS' &amp;&amp; !query.not &amp;&amp; (query.left == '__NAME__' || query.left == '__UID__')) { def val = (query.right as String).trim(); if (val.startsWith('SEDE-')) { val = val.substring(5) }; whereClause = ' AND s.ID_SEDE = ?'; try { params &lt;&lt; Long.parseLong(val) } catch (NumberFormatException e) { params &lt;&lt; val } } else { throw new UnsupportedOperationException('Sedes searchScript solo soporta EqualsFilter en __NAME__/__UID__; recibido: ' + query) } }; def finalQuery = (baseQuery + whereClause).toString(); sql.eachRow(finalQuery, params) { row -&gt; def idSede = row.ID_SEDE?.toString(); result &lt;&lt; ['__UID__': idSede, '__NAME__': 'SEDE-' + idSede, 'ID_SEDE': idSede, 'NOMBRE': (row.NOMBRE?.toString() ?: ''), 'SIGLA': (row.SIGLA?.toString() ?: ''), 'CODIGO': row.CODIGO?.toString(), 'CODSUNEDU': row.CODSUNEDU?.toString()] }; return result</cfg:searchScript>

            <cfg:syncScript>return null</cfg:syncScript>

            <cfg:schemaScript>import org.identityconnectors.framework.common.objects.AttributeInfoBuilder; import org.identityconnectors.framework.common.objects.ObjectClass; import org.identityconnectors.framework.common.objects.ObjectClassInfoBuilder; def ro = { String attrName, boolean required -&gt; def aib = new AttributeInfoBuilder(attrName, String.class); aib.setRequired(required); aib.setCreateable(false); aib.setUpdateable(false); aib.setReadable(true); aib.build() }; def ocib = new ObjectClassInfoBuilder(); ocib.setType(ObjectClass.ACCOUNT_NAME); ocib.addAttributeInfo(ro('ID_SEDE', true)); ocib.addAttributeInfo(ro('NOMBRE', true)); ocib.addAttributeInfo(ro('SIGLA', false)); ocib.addAttributeInfo(ro('CODIGO', false)); ocib.addAttributeInfo(ro('CODSUNEDU', false)); builder.defineObjectClass(ocib.build())</cfg:schemaScript>

            <cfg:testScript>import groovy.sql.Sql; def sql = new Sql(connection); def row = sql.firstRow('SELECT COUNT(*) AS TOTAL FROM ELISEO.ORG_SEDE WHERE ID_SEDE IN (1,2,3)'); return 'OK - Sedes UPeU in-scope (ID_SEDE 1,2,3): ' + row.TOTAL</cfg:testScript>

        </icfc:configurationProperties>
    </connectorConfiguration>

    <schemaHandling>
        <objectType>
            <kind>generic</kind>
            <intent>sede</intent>
            <displayName>Sede UPeU (LAMB ORG_SEDE)</displayName>
            <default>true</default>
            <objectClass>ri:AccountObjectClass</objectClass>

            <focus>
                <type>c:OrgType</type>
                <!-- archetype-org-campus: ya existe y su descripción es literalmente
                     "Sede física de la institución". NO se crea un archetype-org-sede nuevo:
                     sería duplicar un concepto existente (anti-pattern del libro). -->
                <archetypeRef oid="a0c2e4e3-911c-4146-9447-f91a1416feff" type="c:ArchetypeType"/>
            </focus>

            <!-- identifier = clave inmutable. Es también el ítem de correlación. -->
            <attribute>
                <ref>ri:ID_SEDE</ref>
                <inbound>
                    <name>id-sede-to-identifier</name>
                    <strength>strong</strength>
                    <expression>
                        <script>
                            <code>input != null ? 'SEDE-' + input.toString().trim() : null</code>
                        </script>
                    </expression>
                    <target><path>identifier</path></target>
                </inbound>
                <inbound>
                    <name>id-sede-to-ext-sedeId</name>
                    <strength>strong</strength>
                    <target><path>extension/upeu:sedeId</path></target>
                </inbound>
            </attribute>

            <!-- displayName = etiqueta legible desde la fuente ("Sede Lima", "Filial Juliaca"). -->
            <attribute>
                <ref>ri:NOMBRE</ref>
                <inbound>
                    <name>nombre-to-displayName</name>
                    <strength>strong</strength>
                    <target><path>displayName</path></target>
                </inbound>
            </attribute>

            <!-- name: WEAK a propósito. Los 3 OrgType ya existen como OU-CAMPUS-LIMA/JULIACA/
                 TARAPOTO y se reutilizan (mismo OID, se preserva historia). Un mapping strong
                 los renombraría a SEDE-N sin aportar nada. Weak solo actúa si name está vacío
                 (objeto nuevo, que en este alcance no debería ocurrir). -->
            <attribute>
                <ref>icfs:name</ref>
                <inbound>
                    <name>name-to-name-weak</name>
                    <strength>weak</strength>
                    <target><path>name</path></target>
                </inbound>
            </attribute>

            <!-- FASE 3 (pendiente): aquí irá el inbound de parentOrg hacia SEDES-UPEU
                 (oid 9d9fc9d1-8c2b-49a2-9728-0e0baa15b93f) vía assignmentTargetSearch, una vez
                 que los colegios se hayan movido a "Unidades Adscritas". Añadirlo ahora
                 arrastraría ~91 personas sin simulación. -->

            <correlation>
                <correlators>
                    <items>
                        <name>por-identifier</name>
                        <item>
                            <ref>identifier</ref>
                        </item>
                    </items>
                </correlators>
            </correlation>

            <synchronization>
                <reaction>
                    <situation>linked</situation>
                    <actions><synchronize/></actions>
                </reaction>
                <!-- SIN reacción 'deleted' A PROPÓSITO. Un deleteFocus aquí borraría el OrgType
                     del campus y con él la jerarquía de los colegios y sus ~91 personas ante
                     cualquier fallo transitorio de la consulta. El catálogo de sedes es estable
                     (3 filas); una baja real se gestiona a mano. Lección del leaver-gap del 3-ago:
                     nunca dejar que un fallo de lectura provoque una destrucción en cascada. -->
                <reaction>
                    <situation>unlinked</situation>
                    <actions><link/></actions>
                </reaction>
                <reaction>
                    <situation>unmatched</situation>
                    <actions><addFocus/></actions>
                </reaction>
            </synchronization>
        </objectType>
    </schemaHandling>
</resource>
