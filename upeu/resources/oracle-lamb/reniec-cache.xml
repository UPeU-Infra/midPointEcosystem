<?xml version="1.0" encoding="UTF-8"?>
<!-- ============================================================
     Resource: Oracle LAMB RENIEC Cache
     OID: c4d5e6f7-a8b9-0123-cdef-123456789abc

     Fuente: DAVID.CONSULTA_APIS_LOG (cache de llamadas a API RENIEC)
     Propósito: llevar a MidPoint el nombre del DNI según RENIEC (caché de admisión),
                sin consultar nada. Desde E1 (nombre-oficial-reniec, 2026-11-09) escribe
                upeu:reniecGivenName / upeu:reniecFamilyName (transporte) y el object template
                UserTemplate-Nombre-Oficial decide el nombre visible y upeu:dataQualityStatus.
                Corrección 2026-11-09: RENIEC NO elimina las tildes. Devuelve lo que figura en
                el DNI: con tildes si el DNI las tiene, sin ellas si no (medido contra la caché).
                Con la decisión de UPeU (CRAI + DTI/Infra) ese es el nombre oficial.

     Arquitectura:
       - ScriptedSQL connector (mismo OID que egresados)
       - __UID__ = NRO_DOCUMENTO (DNI del ciudadano)
       - SQL devuelve NRO_DOCUMENTO + CONTENT (JSON raw de RENIEC)
       - Groovy inbound parsea el JSON con JsonSlurper
       - Title Case en Groovy (preposiciones/artículos en minúscula)
       - Correlación por extension/upeu:lambDocNum (DNI zfill 8), E1 2026-11-09. Antes por
         sb:taxId: type-blind, deprecado y vaciado por el Bloque J2 del template, así que no
         enlazaba a quien ya no lo conservara.
       - Reacción unmatched: inactivateShadow (no crea usuarios nuevos)

     Notas de diseño:
       - JSON_VALUE no disponible en esta versión Oracle → parseo en Groovy
       - CONTENT siempre en MAYÚSCULAS desde RENIEC → Title Case obligatorio
       - La dedup toma la entrada MÁS RECIENTE por DNI (ORDER BY FECHA_REGISTRO DESC)
       - Cobertura actual: ~151.245 DNIs únicos validados (mayo 2026)
       - Escribe solo su propio transporte (strong, único escritor de upeu:reniec*Name).
     ============================================================ -->
<resource xmlns="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
    xmlns:c="http://midpoint.evolveum.com/xml/ns/public/common/common-3"
    xmlns:org="http://midpoint.evolveum.com/xml/ns/public/common/org-3"
    xmlns:q="http://prism.evolveum.com/xml/ns/public/query-3"
    xmlns:icfs="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/resource-schema-3"
    xmlns:ri="http://midpoint.evolveum.com/xml/ns/public/resource/instance-3"
    xmlns:t="http://prism.evolveum.com/xml/ns/public/types-3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    oid="c4d5e6f7-a8b9-0123-cdef-123456789abc">

    <name>Oracle LAMB RENIEC Cache v1</name>
    <description>Inbound ScriptedSQL desde DAVID.CONSULTA_APIS_LOG. Enriquece givenName y familyName con datos validados por RENIEC, aplicando Title Case español. No crea usuarios nuevos — solo enriquece existentes correlacionados por DNI.</description>
    <lifecycleState>active</lifecycleState>

    <!-- Mismo conector ScriptedSQL que egresados (OID estable Groovy/Oracle) -->
    <connectorRef oid="e4cd8ed3-2e91-48d9-abb7-32090a5e8849" relation="org:default" type="c:ConnectorType"/>

    <connectorConfiguration xmlns:icfc="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/connector-schema-3">
        <icfc:resultsHandlerConfiguration>
            <icfc:enableNormalizingResultsHandler>false</icfc:enableNormalizingResultsHandler>
            <icfc:enableFilteredResultsHandler>false</icfc:enableFilteredResultsHandler>
            <icfc:filteredResultsHandlerInValidationMode>true</icfc:filteredResultsHandlerInValidationMode>
            <icfc:enableAttributesToGetSearchResultsHandler>false</icfc:enableAttributesToGetSearchResultsHandler>
        </icfc:resultsHandlerConfiguration>
        <icfc:configurationProperties xmlns:cfg="http://midpoint.evolveum.com/xml/ns/public/connector/icf-1/bundle/net.tirasa.connid.bundles.db.scriptedsql/net.tirasa.connid.bundles.db.scriptedsql.ScriptedSQLConnector">
            <cfg:host>192.168.13.9</cfg:host>
            <cfg:port>1521</cfg:port>
            <cfg:user>JUANSANCHEZ</cfg:user>
            <cfg:password>
                <t:encryptedData>
                    <t:encryptionMethod>
                        <t:algorithm>http://www.w3.org/2001/04/xmlenc#aes256-cbc</t:algorithm>
                    </t:encryptionMethod>
                    <t:keyInfo>
                        <t:keyName>nkZ4VieDLlRmwD8hdryrmjz8IxQ=</t:keyName>
                    </t:keyInfo>
                    <t:cipherData>
                        <t:cipherValue>cbS0z8iJBH65IpXN1rHu7W+A4kDoVjubqe3LR3iXW/GlGCOKqSJT4lDv6GSwUeQl</t:cipherValue>
                    </t:cipherData>
                </t:encryptedData>
            </cfg:password>
            <cfg:database>UPEU</cfg:database>
            <cfg:jdbcDriver>oracle.jdbc.OracleDriver</cfg:jdbcDriver>
            <cfg:jdbcUrlTemplate>jdbc:oracle:thin:@%h:%p/%d</cfg:jdbcUrlTemplate>
            <cfg:rethrowAllSQLExceptions>true</cfg:rethrowAllSQLExceptions>
            <cfg:nativeTimestamps>true</cfg:nativeTimestamps>
            <cfg:allNative>false</cfg:allNative>
            <cfg:scriptingLanguage>GROOVY</cfg:scriptingLanguage>
            <cfg:reloadScriptOnExecution>false</cfg:reloadScriptOnExecution>

            <!-- searchScript: dedup por DNI → la llamada más reciente exitosa por persona.
                 NRO_DOCUMENTO es el DNI crudo (8 dígitos).
                 CONTENT es el JSON devuelto por la API RENIEC (VARCHAR2 4000, siempre presente en STATUS='S').
                 No se usa JSON_VALUE (no disponible en esta versión Oracle) — parseo en Groovy.
                 Fix 2026-05-28: ORA-17006 con Oracle JDBC 11g R2 al resolver nombres de columna
                 en subquery exterior con bind parameter. Workaround: acceso por índice (row[0], row[1])
                 en lugar de row.NRO_DOCUMENTO / row.CONTENT en la rama del getObject individual.
                 La rama sin query (list completo) sigue usando nombres porque no tiene bind param. -->
            <cfg:searchScript>import groovy.sql.Sql; def sql = new Sql(connection); def result = []; def innerDedup = 'SELECT NRO_DOCUMENTO, CONTENT, FECHA_REGISTRO, ROW_NUMBER() OVER (PARTITION BY NRO_DOCUMENTO ORDER BY FECHA_REGISTRO DESC) AS RN FROM DAVID.CONSULTA_APIS_LOG WHERE STATUS = \'S\' AND TIPO = \'DNI\' AND CONTENT IS NOT NULL AND NRO_DOCUMENTO IS NOT NULL AND LENGTH(TRIM(NRO_DOCUMENTO)) BETWEEN 7 AND 8'; def dedupCte = "SELECT NRO_DOCUMENTO, CONTENT, FECHA_REGISTRO FROM (${innerDedup}) WHERE RN = 1"; def finalQuery; def params = []; def useIndex = false; if (query != null) { if (query.operation == 'EQUALS' &amp;&amp; !query.not &amp;&amp; (query.left == '__NAME__' || query.left == '__UID__')) { finalQuery = "SELECT t.NRO_DOCUMENTO, t.CONTENT, t.FECHA_REGISTRO FROM (${dedupCte}) t WHERE t.NRO_DOCUMENTO = ?".toString(); params &lt;&lt; (query.right as String); useIndex = true; } else { throw new UnsupportedOperationException('reniec-cache searchScript solo soporta EqualsFilter en __NAME__/__UID__; recibido: ' + query); } } else { finalQuery = dedupCte; }; sql.eachRow(finalQuery, params) { rs -> def row = rs.toRowResult(); def dni = useIndex ? row[0]?.toString() : row.NRO_DOCUMENTO?.toString(); def content = useIndex ? row[1]?.toString() : row.CONTENT?.toString(); def fecha = useIndex ? row[2]?.toString() : row.FECHA_REGISTRO?.toString(); result &lt;&lt; ['__UID__': dni, '__NAME__': dni, 'NRO_DOCUMENTO': dni, 'CONTENT': content, 'FECHA_REGISTRO': fecha] }; return result</cfg:searchScript>

            <cfg:syncScript>return null</cfg:syncScript>

            <!-- schemaScript: atributos mínimos — UID/NAME + CONTENT raw -->
            <cfg:schemaScript>import org.identityconnectors.framework.common.objects.AttributeInfoBuilder; import org.identityconnectors.framework.common.objects.ObjectClass; import org.identityconnectors.framework.common.objects.ObjectClassInfoBuilder; def ro = { String attrName, boolean required -> def aib = new AttributeInfoBuilder(attrName, String.class); aib.setRequired(required); aib.setCreateable(false); aib.setUpdateable(false); aib.setReadable(true); aib.build() }; def ocib = new ObjectClassInfoBuilder(); ocib.setType(ObjectClass.ACCOUNT_NAME); ocib.addAttributeInfo(ro("NRO_DOCUMENTO", true)); ocib.addAttributeInfo(ro("CONTENT", true)); ocib.addAttributeInfo(ro("FECHA_REGISTRO", false)); builder.defineObjectClass(ocib.build())</cfg:schemaScript>

            <cfg:testScript>import groovy.sql.Sql; def sql = new Sql(connection); def row = sql.firstRow("SELECT COUNT(*) AS CNT FROM DAVID.CONSULTA_APIS_LOG WHERE STATUS='S' AND TIPO='DNI' AND ROWNUM=1"); return "OK — RENIEC cache accesible"</cfg:testScript>
        </icfc:configurationProperties>
    </connectorConfiguration>

    <schemaHandling>
        <objectType>
            <kind>account</kind>
            <intent>default</intent>
            <displayName>RENIEC Cache — DNI validado</displayName>
            <default>true</default>
            <delineation>
                <objectClass>ri:AccountObjectClass</objectClass>
            </delineation>
            <focus>
                <type>UserType</type>
                <!-- No archetypeRef — RENIEC no define el tipo de usuario.
                     Solo enriquece datos de nombres en usuarios ya existentes. -->
            </focus>

            <!-- NRO_DOCUMENTO → taxId URN (beforeCorrelation + clockwork)
                 El correlator busca usuarios cuyo sb:taxId coincida con la URN derivada del DNI.
                 Mismo esquema URN que egresados.xml para consistencia cross-resource. -->
            <attribute>
                <ref>ri:NRO_DOCUMENTO</ref>
                <inbound>
                    <name>reniec-dni-to-taxId-urn</name>
                    <strength>normal</strength>
                    <expression>
                        <script>
                            <code>def d = (input ?: '').toString().trim(); d ? 'urn:schac:personalUniqueID:pe:DNI:PE:' + d : null</code>
                        </script>
                    </expression>
                    <target>
                        <path xmlns:sb="urn:sciback:midpoint:person">extension/sb:taxId</path>
                    </target>
                    <evaluationPhases>
                        <include>beforeCorrelation</include>
                        <include>clockwork</include>
                    </evaluationPhases>
                </inbound>
                <!-- E1 2026-11-09: DNI → upeu:lambDocNum SOLO para correlacionar (no se escribe en
                     el usuario: su IIA es Lamb). Mismo CANON_DOC que trabajadores para DNI. -->
                <inbound>
                    <name>reniec-dni-to-lambDocNum-correlation</name>
                    <strength>strong</strength>
                    <expression>
                        <script>
                            <code>def d = (input ?: '').toString().trim(); (d ==~ /\d{7,8}/) ? d.padLeft(8, '0') : null</code>
                        </script>
                    </expression>
                    <target>
                        <path xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:lambDocNum</path>
                    </target>
                    <evaluationPhases>
                        <include>beforeCorrelation</include>
                        <exclude>clockwork</exclude>
                    </evaluationPhases>
                </inbound>
            </attribute>

            <!-- CONTENT → upeu:reniecGivenName / upeu:reniecFamilyName (E1 2026-11-09)
                 Parsea "nombres", "ap_paterno", "ap_materno" del JSON con JsonSlurper y aplica
                 sb-name-normalizer.toOfficialName (de, del, la, las, los, y en minúscula; guiones y
                 apóstrofos). Escribe SOLO transporte; el nombre visible lo decide
                 UserTemplate-Nombre-Oficial comparando con el apellido de Lamb.
                 Historia: el 29-jun-2026 estos mappings pasaron a weak porque chocaban con
                 trabajadores sobre givenName (dos escritores single-valued). Aquella nota decía que
                 RENIEC entrega el nombre sin diacríticos: ERA FALSO. Medido el 9-nov-2026: RENIEC
                 devuelve lo que figura en el DNI (con tildes o sin ellas). Desde E1 cada fuente
                 escribe su propio transporte y ese choque ya no puede ocurrir.
                 RENIEC sigue siendo IIA de reniecValidationDate. -->
            <attribute>
                <ref>ri:CONTENT</ref>
                <inbound>
                    <name>reniec-content-to-reniecGivenName</name>
                    <!-- E1 2026-11-09: transporte, strong, único escritor; forma toOfficialName
                         (partículas de la regla UPeU, guiones y apóstrofos). Sin condición: ya no
                         compite con nadie. El nombre visible lo elige UserTemplate-Nombre-Oficial. -->
                    <strength>strong</strength>
                    <expression>
                        <function>
                            <libraryRef oid="0b6f3a1c-2d4e-4f5a-9b8c-7e6d5c4b3a2f" type="FunctionLibraryType"/>
                            <name>toOfficialName</name>
                            <parameter>
                                <name>raw</name>
                                <expression>
                                    <script>
                                        <code>if (input == null || input.toString().trim().isEmpty()) return null; try { def json = new groovy.json.JsonSlurper().parseText(input.toString()); def n = json?.nombres?.toString()?.trim(); return n ?: null } catch (Exception e) { log.warn('reniec-cache: nombres parse error {}', e.getMessage()); return null }</code>
                                    </script>
                                </expression>
                            </parameter>
                        </function>
                    </expression>
                    <target><path xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:reniecGivenName</path></target>
                </inbound>

                <!-- CONTENT → familyName (ap_paterno + ap_materno, Title Case)
                     Construye el apellido completo concatenando ambos campos RENIEC.
                     Se omite ap_materno si está vacío (ciudadanos con un solo apellido). -->
                <inbound>
                    <!-- WEAK (FIX 2026-06-29): ver justificación en reniec-content-to-givenName.
                         trabajadores es el único strong de familyName.
                         LAST-RESORT: solo rellena si el foco aún no tiene familyName. -->
                    <name>reniec-content-to-reniecFamilyName</name>
                    <strength>strong</strength>
                    <expression>
                        <function>
                            <libraryRef oid="0b6f3a1c-2d4e-4f5a-9b8c-7e6d5c4b3a2f" type="FunctionLibraryType"/>
                            <name>toOfficialName</name>
                            <parameter>
                                <name>raw</name>
                                <expression>
                                    <script>
                                        <code>if (input == null || input.toString().trim().isEmpty()) return null; try { def json = new groovy.json.JsonSlurper().parseText(input.toString()); def pat = json?.ap_paterno?.toString()?.trim() ?: ''; def mat = json?.ap_materno?.toString()?.trim() ?: ''; def full = (pat + (mat ? ' ' + mat : '')).trim(); return full ?: null } catch (Exception e) { log.warn('reniec-cache: apellidos parse error {}', e.getMessage()); return null }</code>
                                    </script>
                                </expression>
                            </parameter>
                        </function>
                    </expression>
                    <target><path xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:reniecFamilyName</path></target>
                </inbound>

                <!-- CONTENT → dataQualityStatus
                     reniec_validated: CONTENT parseable y se extrajeron nombres.
                     mismatch: CONTENT parseable pero nombres RENIEC difieren >30% de los actuales.
                     No sobreescribe manual_override.
                     strength=strong: RENIEC es fuente jurídica de mayor confianza.
                     Fix 2026-05-27: consolidado en el bloque ri:CONTENT único (evita ORA Duplicate definition). -->
                <inbound>
                    <name>reniec-content-to-dataQualityStatus</name>
                    <!-- ARCHIVED E1 2026-11-09: dataQualityStatus lo decide UserTemplate-Nombre-Oficial
                         (único escritor). Dos escritores sobre un ítem single-valued chocarían. -->
                    <lifecycleState>archived</lifecycleState>
                    <strength>strong</strength>
                    <condition>
                        <script>
                            <code>if (focus == null) return false; def currentStatus = basic.getExtensionPropertyValue(focus, new javax.xml.namespace.QName('urn:upeu:midpoint:local','dataQualityStatus'))?.toString(); return currentStatus != 'manual_override'</code>
                        </script>
                    </condition>
                    <expression>
                        <script>
                            <code>
if (input == null || input.toString().trim().isEmpty()) return null
try {
    def json = new groovy.json.JsonSlurper().parseText(input.toString())
    def nombres = json?.nombres?.toString()?.trim()
    def pat = json?.ap_paterno?.toString()?.trim()
    if (!nombres &amp;&amp; !pat) return null
    // Detectar mismatch: si el foco ya tiene nombres y difieren significativamente
    def focusGiven = focus?.givenName?.toString()?.trim()?.toUpperCase() ?: ''
    def focusFamily = focus?.familyName?.toString()?.trim()?.toUpperCase() ?: ''
    def reniecNombres = (nombres ?: '').toUpperCase()
    def reniecApellidos = ((json?.ap_paterno?.toString()?.trim() ?: '') + ' ' + (json?.ap_materno?.toString()?.trim() ?: '')).trim().toUpperCase()
    if (focusGiven &amp;&amp; focusFamily) {
        def givenMatch = focusGiven.contains(reniecNombres) || reniecNombres.contains(focusGiven)
        def familyMatch = focusFamily.contains(reniecApellidos) || reniecApellidos.contains(focusFamily)
        if (!givenMatch &amp;&amp; !familyMatch) return 'mismatch'
    }
    return 'reniec_validated'
} catch (Exception e) {
    log.warn('reniec-cache: dataQualityStatus error: ' + e.getMessage())
    return null
}
                            </code>
                        </script>
                    </expression>
                    <target>
                        <path xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:dataQualityStatus</path>
                    </target>
                </inbound>
            </attribute>

            <!-- FECHA_REGISTRO → reniecValidationDate
                 Timestamp de la consulta RENIEC más reciente en el cache Oracle.
                 No sobreescribe manual_override. -->
            <attribute>
                <ref>ri:FECHA_REGISTRO</ref>
                <inbound>
                    <name>reniec-fecha-to-validationDate</name>
                    <strength>strong</strength>
                    <condition>
                        <script>
                            <code>if (focus == null) return false; def currentStatus = basic.getExtensionPropertyValue(focus, new javax.xml.namespace.QName('urn:upeu:midpoint:local','dataQualityStatus'))?.toString(); return currentStatus != 'manual_override' &amp;&amp; input != null</code>
                        </script>
                    </condition>
                    <expression>
                        <script>
                            <code>
if (input == null) return null
try {
    def ts = java.sql.Timestamp.valueOf(input.toString())
    def gc = new java.util.GregorianCalendar()
    gc.setTimeInMillis(ts.getTime())
    return javax.xml.datatype.DatatypeFactory.newInstance().newXMLGregorianCalendar(gc)
} catch (Exception e) {
    log.warn('reniec-cache: reniecValidationDate parse error: ' + e.getMessage())
    return null
}
                            </code>
                        </script>
                    </expression>
                    <target>
                        <path xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:reniecValidationDate</path>
                    </target>
                </inbound>
            </attribute>

            <!-- Correlación por taxId (DNI URN)
                 El inbound reniec-dni-to-taxId-urn (beforeCorrelation) prepara la URN
                 antes de que este correlator evalúe.
                 Solo encuentra usuarios existentes — no crea usuarios nuevos (ver unmatched abajo). -->
            <correlation>
                <correlators>
                    <items>
                        <name>correlate-by-lambDocNum</name>
                        <item>
                            <ref xmlns:upeu="urn:upeu:midpoint:local">extension/upeu:lambDocNum</ref>
                        </item>
                    </items>
                </correlators>
            </correlation>

            <synchronization>
                <!-- linked → synchronize: actualiza givenName/familyName con datos RENIEC -->
                <reaction>
                    <situation>linked</situation>
                    <actions><synchronize/></actions>
                </reaction>
                <!-- unlinked → link + synchronize: ya existe el usuario, lo vinculamos y enriquecemos -->
                <reaction>
                    <situation>unlinked</situation>
                    <actions><link/><synchronize/></actions>
                </reaction>
                <!-- unmatched → (sin acción): no hay usuario en MidPoint con este DNI.
                     RENIEC solo enriquece — no crea usuarios nuevos.
                     El shadow no procesado simplemente se ignora. -->
                <reaction>
                    <situation>unmatched</situation>
                    <actions/>
                </reaction>
                <!-- deleted → unlink: si el registro RENIEC desaparece (improbable), desvinculamos.
                     No afecta el usuario de MidPoint (los nombres ya enriquecidos se conservan). -->
                <reaction>
                    <situation>deleted</situation>
                    <actions><unlink/></actions>
                </reaction>
            </synchronization>
        </objectType>
    </schemaHandling>

    <!-- Read-only: RENIEC cache es fuente inbound, no se escriben datos de vuelta -->
    <capabilities>
        <configured xmlns:cap="http://midpoint.evolveum.com/xml/ns/public/resource/capabilities-3">
            <cap:create>
                <cap:enabled>false</cap:enabled>
            </cap:create>
            <cap:update>
                <cap:enabled>false</cap:enabled>
            </cap:update>
            <cap:delete>
                <cap:enabled>false</cap:enabled>
            </cap:delete>
        </configured>
    </capabilities>

    <projection>
        <assignmentPolicyEnforcement>relative</assignmentPolicyEnforcement>
    </projection>
</resource>
